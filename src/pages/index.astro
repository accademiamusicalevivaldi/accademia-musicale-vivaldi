---
import Layout from '../layouts/SiteLayout.astro';import Cover from '../components/Cover.astro';import Locations from '../components/Locations.astro';import Heading from '../components/Heading.astro';
import home from '../data/home.json';import site from '../data/site.json';import courses from '../data/courses.json';import {news,albums,formatDate} from '../lib/collections';
---
<Layout title={`${site.name} — ${home.title} ${home.emphasis}`}>
<Cover/>
<section class="welcome section" id="accademia"><div><p class="eyebrow red">{home.welcomeEyebrow}</p><Heading text={home.welcomeTitle} emphasis={home.welcomeEmphasis}/></div><div class="welcome-copy">{home.welcomeParagraphs.map(text=><p>{text}</p>)}<a class="text-link" href="#contatti">Conosciamoci <span aria-hidden="true">↗</span></a></div></section>
<section class="courses section" id="corsi"><div class="section-heading"><div><p class="eyebrow red">{home.coursesEyebrow}</p><Heading text={home.coursesTitle} emphasis={home.coursesEmphasis}/></div><p>{home.coursesIntro}</p></div><div class="course-grid">{courses.items.map((course,index)=><a class="course" href="#contatti"><div class="course-top"><span class="course-number">{String(index+1).padStart(2,'0')} /</span><img class="course-icon" src={course.icon} alt="" width="50" height="50" loading="lazy"/></div><h3>{course.title}</h3><p>{course.description}</p><span class="course-arrow" aria-hidden="true">↗</span></a>)}</div><p class="course-note">{home.coursesNote}</p></section>
<section class="quote-band"><p>{home.quote}<br/><em>{home.quoteEmphasis}</em></p><a class="button light" href="#contatti">Richiedi informazioni <span aria-hidden="true">↗</span></a></section>
<section class="journal section" id="notizie"><div class="section-heading"><div><p class="eyebrow red">{home.newsEyebrow}</p><Heading text={home.newsTitle} emphasis={home.newsEmphasis}/></div><a class="text-link" href="/notizie/">Tutte le notizie ↗</a></div>{news.length?<div class="content-grid">{news.slice(0,3).map(item=><article class="content-card"><a href={`/notizie/${item.slug}/`}>{item.cover&&<img src={item.cover} alt="" loading="lazy"/>}<time datetime={item.date}>{formatDate(item.date)}</time><h3>{item.title}</h3><p>{item.excerpt}</p></a></article>)}</div>:<p>{home.newsEmpty}</p>}<div class="gallery-teaser" id="gallerie"><div><p class="eyebrow red">{home.galleryEyebrow}</p><Heading text={home.galleryTitle} emphasis={home.galleryEmphasis}/><p>{albums.length?home.galleryIntro:home.galleryEmpty}</p></div><a class="button outline" href="/gallerie/">Esplora le gallerie ↗</a></div></section>
<section class="documents section" id="documenti"><div><p class="eyebrow red">{home.documentsEyebrow}</p><Heading text={home.documentsTitle} emphasis={home.documentsEmphasis}/></div><div><p>{home.documentsIntro}</p><a class="button outline" href="/documenti/">Materiale didattico e PDF ↗</a></div></section>
<Locations/>
<section class="contact section" id="contatti"><div><p class="eyebrow">{home.contactEyebrow}</p><Heading text={home.contactTitle} emphasis={home.contactEmphasis}/><p>{home.contactIntro}</p></div><div class="contact-details"><span class="small-label">SEGRETERIA</span><a href={`mailto:${site.email}`}>{site.email} ↗</a>{site.contacts.map(contact=><div class="teacher-contact"><span>{contact.name}</span><a href={'tel:'+contact.phone.replace(/[^+\d]/g,'')}>{contact.phone}</a></div>)}<p>{site.city}</p></div></section>
</Layout>
