---
import Layout from '../../layouts/SiteLayout.astro';import {news,formatDate} from '../../lib/collections';
---
<Layout title="Notizie — Accademia Vivaldi"><section class="section page-content"><p class="eyebrow red">LA VITA DELL’ACCADEMIA</p><h1>Le nostre <em>notizie.</em></h1><p>Aggiornamenti, appuntamenti e iniziative.</p>{news.length?<div class="content-grid">{news.map(item=><article class="content-card"><a href={`/notizie/${item.slug}/`}>{item.cover&&<img src={item.cover} alt="" loading="lazy"/>}<time datetime={item.date}>{formatDate(item.date)}</time><h3>{item.title}</h3><p>{item.excerpt}</p></a></article>)}</div>:<div class="empty-state">Non ci sono ancora notizie pubblicate. Torna presto a trovarci.</div>}</section></Layout>
