---
import Layout from '../../layouts/SiteLayout.astro';import {albums,formatDate} from '../../lib/collections';
const years=[...new Set(albums.map(item=>item.date.slice(0,4)))];const places=[...new Set(albums.map(item=>item.location))].sort();
---
<Layout title="Gallerie dei saggi — Accademia Vivaldi"><section class="section page-content"><p class="eyebrow red">MOMENTI DA RICORDARE</p><h1>La musica <em>insieme.</em></h1><p>Rivivi i saggi dell’Accademia, per anno e località.</p>{albums.length?<><div class="gallery-filters"><label>Anno<select id="year"><option value="">Tutti gli anni</option>{years.map(year=><option>{year}</option>)}</select></label><label>Località<select id="place"><option value="">Tutte le località</option>{places.map(place=><option>{place}</option>)}</select></label><button class="button outline" id="clear-filters">Azzera filtri</button></div><p id="gallery-count" aria-live="polite">{albums.length} album</p><div class="content-grid">{albums.map(item=><article class="content-card album-card" data-year={item.date.slice(0,4)} data-place={item.location}><a href={`/gallerie/${item.slug}/`}>{(item.cover||item.photos?.[0]?.thumbnail||item.photos?.[0]?.url)&&<img src={item.cover||item.photos[0].thumbnail||item.photos[0].url} alt="" loading="lazy"/>}<time datetime={item.date}>{formatDate(item.date)} · {item.location}</time><h3>{item.title}</h3><p>{item.description}</p></a></article>)}</div><p id="gallery-empty" hidden>Nessun album corrisponde ai filtri selezionati.</p></>:<div class="empty-state">I primi album saranno disponibili qui.</div>}</section></Layout>
<script>
const year=document.querySelector<HTMLSelectElement>('#year');const place=document.querySelector<HTMLSelectElement>('#place');
function filter(){let count=0;document.querySelectorAll<HTMLElement>('.album-card').forEach(card=>{card.hidden=Boolean((year?.value&&year.value!==card.dataset.year)||(place?.value&&place.value!==card.dataset.place));if(!card.hidden)count++;});const counter=document.querySelector('#gallery-count');if(counter)counter.textContent=`${count} album`;const empty=document.querySelector<HTMLElement>('#gallery-empty');if(empty)empty.hidden=count!==0;}
year?.addEventListener('change',filter);place?.addEventListener('change',filter);document.querySelector('#clear-filters')?.addEventListener('click',()=>{if(year)year.value='';if(place)place.value='';filter();});
</script>
