{
  "name": "accademia-vivaldi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/validate.mjs && astro build && wrangler pages functions build --outfile dist/_worker.js",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "cms:local": "decap-server",
    "deploy": "wrangler pages deploy dist"
  },
  "dependencies": {
    "astro": "^5.13.0",
    "leaflet": "^1.9.4",
    "marked": "^18.0.13",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "decap-server": "^3.11.2",
    "wrangler": "^4.132.0"
  }
}
