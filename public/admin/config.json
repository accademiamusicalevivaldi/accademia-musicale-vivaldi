      "fields": [
        {
          "name": "title",
          "label": "Titolo",
          "widget": "string"
        },
        {
          "name": "date",
          "label": "Data",
          "widget": "datetime",
          "date_format": "DD/MM/YYYY",
          "time_format": false,
          "format": "YYYY-MM-DD"
        },
        {
          "name": "draft",
          "label": "Bozza (disattiva per pubblicare)",
          "widget": "boolean",
          "default": true
        },
        {
          "name": "excerpt",
          "label": "Riassunto",
          "widget": "text"
        },
        {
          "name": "cover",
